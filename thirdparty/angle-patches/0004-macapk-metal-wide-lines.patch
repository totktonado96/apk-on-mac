+// Mac.apk (patch 0004): the aliased line width range we advertise when the GPU's
+// render encoder can rasterize wide lines. 8 is MoltenVK's lineWidthRange[1] for
+// the same private Metal call (MVKDevice.mm: "lineWidthRange[1] = wideLines ? 8
+// : 1"), which ANGLE-Vulkan passes straight through as maxAliasedLineWidth
+// (vk_caps_utils.cpp), so an app gets the same GL answer from both of the
+// backends Mac.apk ships. Measured on Apple M2 (AGXG14GFamilyRenderContext):
+// setLineWidth: w draws exactly w rows for every w up to 16, the driver's own
+// clamp, so 8 is inside what the hardware really does.
+constexpr float kMacapkMaxAliasedLineWidth = 8.0f;
+
+// Mac.apk (patch 0004): why a wide-line probe came back negative. Only the
+// kill switch is silent; every other outcome is named in the runtime log.
+enum class MacapkLineWidthProbe
+{
+    Supported,
+    NoDevice,
+    NoQueueOrTarget,
+    NoEncoder,
+    EncoderLacksSetLineWidth,
+};
+
+// Mac.apk (patch 0004): does this device's render encoder implement the private
+// -setLineWidth:? There is no device or feature-set query for it, so ask a real
+// encoder: a 1x1 render pass on a throwaway queue that is never committed.
+static MacapkLineWidthProbe MacapkProbeEncoderSetLineWidth(id<MTLDevice> device)
+{
+    if (device == nil)
+    {
+        return MacapkLineWidthProbe::NoDevice;
+    }
+    ANGLE_MTL_OBJC_SCOPE
+    {
+        auto queue = angle::adoptObjCPtr([device newCommandQueue]);
+        MTLTextureDescriptor *texDesc =
+            [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+                                                               width:1
+                                                              height:1
+                                                           mipmapped:NO];
+        texDesc.usage       = MTLTextureUsageRenderTarget;
+        texDesc.storageMode = MTLStorageModePrivate;
+        auto texture        = angle::adoptObjCPtr([device newTextureWithDescriptor:texDesc]);
+        if (!queue || !texture)
+        {
+            return MacapkLineWidthProbe::NoQueueOrTarget;
+        }
+        MTLRenderPassDescriptor *passDesc = [MTLRenderPassDescriptor renderPassDescriptor];
+        passDesc.colorAttachments[0].texture     = texture.get();
+        passDesc.colorAttachments[0].loadAction  = MTLLoadActionDontCare;
+        passDesc.colorAttachments[0].storeAction = MTLStoreActionDontCare;
+        id<MTLCommandBuffer> cmdBuffer           = [queue.get() commandBuffer];
+        id<MTLRenderCommandEncoder> encoder =
+            [cmdBuffer renderCommandEncoderWithDescriptor:passDesc];
+        if (encoder == nil)
+        {
+            return MacapkLineWidthProbe::NoEncoder;
+        }
+        const bool responds = [encoder respondsToSelector:@selector(setLineWidth:)];
+        [encoder endEncoding];
+        // cmdBuffer is autoreleased and never committed, so no GPU work is queued.
+        return responds ? MacapkLineWidthProbe::Supported
+                        : MacapkLineWidthProbe::EncoderLacksSetLineWidth;
+    }
+}
+
+// Mac.apk (patch 0004): advertise wide lines only when the encoder has
+// setLineWidth:. MACAPK_ANGLE_WIDE_LINES=0 (read once per process) skips the
+// probe entirely and logs nothing, which restores upstream's [1,1] exactly and
+// means no private-API call is ever made. Any OTHER negative result is logged
+// with its reason, once per display initialization (caps are computed once).
+// All of them fall back to the same [1,1] and 1 px lines, so without the log
+// line a host that lost the capability, a probe that failed and the kill switch
+// would be indistinguishable short of running debug/gl_linewidth_probe.sh on
+// that machine. Literal-only fprintf calls keep the libc unsafe-buffers check
+// quiet.
+static bool MacapkEncoderHasSetLineWidth(id<MTLDevice> device)
+{
+    static const bool sDisabled = angle::GetEnvironmentVar("MACAPK_ANGLE_WIDE_LINES") == "0";
+    if (sDisabled)
+    {
+        return false;
+    }
+    switch (MacapkProbeEncoderSetLineWidth(device))
+    {
+        case MacapkLineWidthProbe::Supported:
+            return true;
+        case MacapkLineWidthProbe::NoDevice:
+            fprintf(stderr, "[macapk-angle] wide GL lines off (1 px): no Metal device\n");
+            break;
+        case MacapkLineWidthProbe::NoQueueOrTarget:
+            fprintf(stderr,
+                    "[macapk-angle] wide GL lines off (1 px): could not create the "
+                    "probe's command queue or 1x1 render target\n");
+            break;
+        case MacapkLineWidthProbe::NoEncoder:
+            fprintf(stderr,
+                    "[macapk-angle] wide GL lines off (1 px): could not create the "
+                    "probe's render command encoder\n");
+            break;
+        case MacapkLineWidthProbe::EncoderLacksSetLineWidth:
+            fprintf(stderr,
+                    "[macapk-angle] wide GL lines off (1 px): this GPU's render "
+                    "command encoder does not implement setLineWidth:\n");
+            break;
+    }
+    return false;
+}
