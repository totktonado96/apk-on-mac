+RenderCommandEncoder &RenderCommandEncoder::setLineWidth(float width)
+{
+    mRequestedLineWidth = width;
+    return *this;
+}
+
+// Mac.apk (patch 0004). GLES line width applies only to primitives rasterized
+// as lines: GL_LINES / GL_LINE_STRIP (and GL_LINE_LOOP, which this backend draws
+// as a line strip plus a closing MTLPrimitiveTypeLine), and triangles drawn with
+// polygon mode LINE, whose edges are line segments. Encoding the width only for
+// those draws means an app that never draws a line never reaches the private
+// method, and a width that never leaves 1.0 never emits anything at all.
+void RenderCommandEncoder::applyLineWidth(MTLPrimitiveType primitiveType)
+{
+    const bool rasterizesLines =
+        primitiveType == MTLPrimitiveTypeLine || primitiveType == MTLPrimitiveTypeLineStrip ||
+        ((primitiveType == MTLPrimitiveTypeTriangle ||
+          primitiveType == MTLPrimitiveTypeTriangleStrip) &&
+         mStateCache.triangleFillMode == MTLTriangleFillModeLines);
+    if (!rasterizesLines || mStateCache.lineWidth == mRequestedLineWidth)
+    {
+        return;
+    }
+    mStateCache.lineWidth = mRequestedLineWidth;
+    mCommands.push(CmdType::SetLineWidth).push(mRequestedLineWidth);
+}
