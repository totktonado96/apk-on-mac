 // Loads any data indicated by the creation info.
 // This is the compliment of the writeData() function. The two must be kept aligned.
+// Mac.apk: one shader library read from the pipeline cache, held until it is compiled.
+struct MVKPipelineCacheReadEntry {
+	MVKShaderModuleKey smKey;
+	SPIRVToMSLConversionConfiguration shaderConversionConfig;
+	SPIRVToMSLConversionResultInfo resultInfo;
+	MVKCompressor<std::string> compressedMSL;
+	MVKShaderLibrary* shLib = nullptr;
+};
+
+// Mac.apk: compile the libraries read from a pipeline cache on several threads.
+// Each MVKShaderLibrary compiles its MSL synchronously, so reading a large cache
+// one entry at a time kept a single MTLCompilerService busy while the rest idled:
+// a game that hands back a big cache (Asphalt Legends' is ~35 MB) sat on its logo
+// for minutes whenever the macOS Metal shader cache was cold. Entries are still
+// added to the caches in their stored order. MACAPK_MVK_PLC_THREADS=1 restores the
+// one-at-a-time compile; any other number sets the thread count.
+static void mvkCompilePipelineCacheEntries(MVKPipelineCache* plc, id<MTLDevice> mtlDev,
+										   std::vector<MVKPipelineCacheReadEntry>& entries) {
+	size_t threadCnt = std::max<NSUInteger>(1, NSProcessInfo.processInfo.activeProcessorCount);
+	if (const char* ev = getenv("MACAPK_MVK_PLC_THREADS")) {
+		long n = strtol(ev, nullptr, 10);
+		if (n > 0) { threadCnt = (size_t)n; }
+	}
+	threadCnt = std::min(threadCnt, entries.size());
+
+	std::atomic<size_t> next(0);
+	auto worker = [&]() {
+		for (size_t i = next++; i < entries.size(); i = next++) {
+			@autoreleasepool {
+				auto& e = entries[i];
+				e.shLib = new MVKShaderLibrary(plc, e.resultInfo, e.compressedMSL);
+			}
+		}
+	};
+
+	if (threadCnt <= 1) { worker(); return; }
+
+	bool hadMaxConcurrent = false;
+	if (@available(macOS 13.3, iOS 16.4, tvOS 16.4, *)) {
+		hadMaxConcurrent = mtlDev.shouldMaximizeConcurrentCompilation;
+		mtlDev.shouldMaximizeConcurrentCompilation = YES;
+	}
+	std::vector<std::thread> threads;
+	threads.reserve(threadCnt - 1);
+	for (size_t t = 1; t < threadCnt; t++) { threads.emplace_back(worker); }
+	worker();
+	for (auto& th : threads) { th.join(); }
+	if (@available(macOS 13.3, iOS 16.4, tvOS 16.4, *)) {
+		mtlDev.shouldMaximizeConcurrentCompilation = hadMaxConcurrent;
+	}
+}
