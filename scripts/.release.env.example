# Copy to scripts/.release.env (untracked) and fill in.
# None of these are secrets -- they are account identifiers. The App Store
# Connect private key (.p8) is referenced by PATH and never read by our scripts.
MACAPK_SIGN_IDENTITY="Developer ID Application: NAME (TEAMID)"
MACAPK_NOTARY_ISSUER="00000000-0000-0000-0000-000000000000"
# Optional: auto-detected from ~/.appstoreconnect/private_keys/AuthKey_*.p8
# MACAPK_NOTARY_KEY="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"
# MACAPK_NOTARY_KEY_ID="XXXXXXXXXX"
